#!/bin/bash

# Default packages if none specified
DEFAULT_PROJECTS=(
    "strata-go"
    "pgwf"
    "pgwf-go"
    "swf-go"
    "shai"
)

# Build packages array from arguments or use defaults
PACKAGES=()
if [[ $# -eq 0 ]]; then
    for project in "${DEFAULT_PROJECTS[@]}"; do
        PACKAGES+=("github.com/colony-2/$project")
    done
else
    for project in "$@"; do
        PACKAGES+=("github.com/colony-2/$project")
    done
fi

echo "Starting dependency updates..."
echo "Packages to update: ${PACKAGES[*]}"

# Create temp directory for output files
TMPDIR=$(mktemp -d)
trap 'rm -rf $TMPDIR' EXIT

# Function to process a single directory
process_dir() {
    local dir=$1
    local outfile=$2
    shift 2
    local packages=("$@")

    {
        echo "----------------------------------------------------"
        echo "Processing project: $dir"

        cd "$dir" || return

        # Build list of packages that this project actually uses
        local to_update=()
        for pkg in "${packages[@]}"; do
            if go list -m "$pkg" > /dev/null 2>&1; then
                to_update+=("$pkg@latest")
            fi
        done

        if [[ ${#to_update[@]} -gt 0 ]]; then
            echo "Updating: ${to_update[*]}"
            go get -u "${to_update[@]}" 2>&1
            echo "Running go mod tidy..."
            go mod tidy 2>&1
        else
            echo "No matching packages found in this project."
        fi
    } > "$outfile" 2>&1
}

# Iterate through each subdirectory in parallel
pids=()
outfiles=()
for dir in */; do
    dir=${dir%/}

    if [[ -f "$dir/go.mod" ]]; then
        outfile="$TMPDIR/$dir.out"
        outfiles+=("$outfile")
        process_dir "$dir" "$outfile" "${PACKAGES[@]}" &
        pids+=($!)
    fi
done

# Wait for all background jobs to complete
for pid in "${pids[@]}"; do
    wait "$pid"
done

# Print all output sequentially
for outfile in "${outfiles[@]}"; do
    cat "$outfile"
done

echo "----------------------------------------------------"
echo "Done!"