{
  "name": "be-openapi",
  "root": "server/openapi",
  "projectType": "library",
  "tags": ["backend", "go", "api"],
  "targets": {
    "codegen": {
      "executor": "nx:run-commands",
      "dependsOn": ["api-openapi:build"],
      "options": {
        "command": "go run github.com/deepmap/oapi-codegen/v2/cmd/oapi-codegen@v2.1.0 -config codegen.yml -o pkg/openapi/generated.go ../../api/openapi/colony2-api.yaml",
        "cwd": "server/openapi",
        "outputs": ["{projectRoot}/pkg/openapi/generated.go"]
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["codegen"],
      "options": {
        "command": "go build ./...",
        "cwd": "server/openapi"
      }
    },
    "test": {
      "executor": "@nx-go/nx-go:test"
    },
    "tidy": {
      "executor": "@nx-go/nx-go:tidy"
    }
  }
}
