{
  "name": "be-api",
  "root": "server/api",
  "projectType": "library",
  "tags": ["backend", "go"],
  "targets": {
    "build-test-server": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go build -o build/testserver ./cmd/testserver",
        "cwd": "server/api",
        "outputs": ["{projectRoot}/build/testserver"]
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go build ./...",
        "cwd": "server/api"
      }
    },
    "test": {
      "executor": "@nx-go/nx-go:test"
    },
    "tidy": {
      "executor": "@nx-go/nx-go:tidy"
    }
  }
}
