{
  "name": "server-llm",
  "root": "server/llm",
  "projectType": "library",
  "tags": ["backend", "go"],
  "targets": {
    "build": {
      "executor": "@nx-go/nx-go:build",
      "options": {
        "main": "./..."
      }
    },
    "test": {
      "executor": "@nx-go/nx-go:test"
    },
    "integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go test -v -tags=integration ./integration/...",
        "cwd": "server/llm"
      }
    }
  }
}
