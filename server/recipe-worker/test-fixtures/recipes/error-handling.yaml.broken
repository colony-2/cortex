id: error-handling-example
desc: Example recipe demonstrating different error type handling
version: "1.0.0"

# Root is a state machine
state:
  initial: fetchData
  
  variables:
    retryCount: 0
    maxRetries: 3
    lastErrorType: ""
    data: null
    processedData: null
  
  states:
    fetchData:
    op:
      fetchExternalData
    inputs:
    url:
      "${config.dataSourceUrl}"
    timeout:
      "30s"
    outputs:
    data:
      data
    retryPolicy:
    maximumAttempts:
      2
    initialInterval:
      "1s"
    backoffCoefficient:
      2.0
    transitions:
      # Check for specific error types using CEL expressions
      - condition: 'error != nil && error.contains("timeout")'
    to:
      handleTimeout
    actions:
          - set: lastErrorType
    value:
      '"timeout"'
      
      - condition: 'error != nil && error.contains("unauthorized")'
    to:
      handleAuthError
    actions:
          - set: lastErrorType
    value:
      '"unauthorized"'
      
      - condition: 'error != nil && error.contains("not found")'
    to:
      handleNotFound
    actions:
          - set: lastErrorType
    value:
      '"not_found"'
      
      - condition: 'error != nil && error.contains("rate limit")'
    to:
      handleRateLimit
    actions:
          - set: lastErrorType
    value:
      '"rate_limit"'
      
      # Generic error handler for unknown errors
      - condition: 'error != nil'
    to:
      handleGenericError
    actions:
          - set: lastErrorType
    value:
      '"unknown"'
      
      # Success path
      - condition: 'data != null'
    to:
      processData

    handleTimeout:
    sequence:
      - id: logTimeout
    op:
      logTimeout
    inputs:
    message:
      "Operation timed out, attempting with extended timeout"
    severity:
      "warning"
      - id: fetchExternalDataSlowPath
    op:
      fetchExternalDataSlowPath
    inputs:
    url:
      "${config.dataSourceUrl}"
    slowMode:
      true
    timeout:
      "2m"
    outputs:
    data:
      data
    transitions:
      - condition: 'error == nil && data != null'
    to:
      processData
      - condition: 'retryCount < maxRetries'
    to:
      retryWithBackoff
    actions:
          - set: retryCount
    value:
      'retryCount + 1'
      - condition: 'true'
    to:
      criticalFailure

    handleAuthError:
    sequence:
      - id: refreshAuthToken
    op:
      refreshAuthToken
    inputs:
    refreshToken:
      "${config.refreshToken}"
    timeout:
      "10s"
    outputs:
    newToken:
      newToken
      - id: updateCredentials
    op:
      updateCredentials
    inputs:
    token:
      "${newToken}"
    transitions:
      - condition: 'error == nil'
    to:
      fetchData  # Retry with new credentials
      - condition: 'true'
    to:
      authFailure

    handleNotFound:
    sequence:
      - id: createDefaultData
    op:
      createDefaultData
    inputs:
    template:
      "default"
    outputs:
    data:
      data
      - id: logNotFound
    op:
      logNotFound
    inputs:
    message:
      "Resource not found, using default data"
    severity:
      "info"
    transitions:
      - condition: 'data != null'
    to:
      processData
      - condition: 'true'
    to:
      criticalFailure

    handleRateLimit:
    sequence:
      - id: calculateBackoff
    op:
      calculateBackoff
    inputs:
    retryCount:
      "${retryCount}"
    outputs:
    waitDuration:
      waitDuration
      - id: waitForRateLimit
    op:
      waitForRateLimit
    inputs:
    duration:
      "${waitDuration}"
    timeout:
      "5m"
      - id: logRateLimit
    op:
      logRateLimit
    inputs:
    message:
      "Rate limited, waiting ${waitDuration} before retry"
    severity:
      "warning"
    transitions:
      - condition: 'retryCount < maxRetries'
    to:
      fetchData
    actions:
          - set: retryCount
    value:
      'retryCount + 1'
      - condition: 'true'
    to:
      rateLimitExceeded

    handleGenericError:
    sequence:
      - id: logGenericError
    op:
      logGenericError
    inputs:
    message:
      "Unexpected error occurred: ${error}"
    severity:
      "error"
      - id: captureErrorMetrics
    op:
      captureErrorMetrics
    inputs:
    errorType:
      "generic"
    error:
      "${error}"
    transitions:
      - condition: 'retryCount < maxRetries'
    to:
      retryWithBackoff
    actions:
          - set: retryCount
    value:
      'retryCount + 1'
      - condition: 'true'
    to:
      criticalFailure

    retryWithBackoff:
    sequence:
      - id: exponentialBackoff
    op:
      exponentialBackoff
    inputs:
    attempt:
      "${retryCount}"
    baseDelay:
      "2s"
    outputs:
    delay:
      delay
      - id: wait
    op:
      wait
    inputs:
    duration:
      "${delay}"
    transitions:
      - condition: 'true'
    to:
      fetchData

    processData:
    sequence:
      - id: validateData
    op:
      validateData
    inputs:
    data:
      "${data}"
    outputs:
    validationResult:
      validationResult
      - id: transformData
    op:
      transformData
    inputs:
    data:
      "${data}"
    validationResult:
      "${validationResult}"
    timeout:
      "1m"
    outputs:
    processedData:
      processedData
    transitions:
      - condition: 'error != nil && error.contains("validation")'
    to:
      validationError
      - condition: 'error != nil && error.contains("transform")'
    to:
      transformError
      - condition: 'processedData != null'
    to:
      saveResults
      - condition: 'true'
    to:
      processingError

    validationError:
    op:
      attemptDataRepair
    inputs:
    data:
      "${data}"
    outputs:
    repairedData:
      repairedData
    transitions:
      - condition: 'repairedData != null'
    to:
      processData
    actions:
          - set: data
    value:
      'repairedData'
      - condition: 'true'
    to:
      validationFailure

    transformError:
    op:
      fallbackTransform
    inputs:
    data:
      "${data}"
    useSimpleTransform:
      true
    outputs:
    processedData:
      processedData
    transitions:
      - condition: 'processedData != null'
    to:
      saveResults
      - condition: 'true'
    to:
      processingError

    saveResults:
    sequence:
      - id: persistData
    op:
      persistData
    inputs:
    data:
      "${processedData}"
    timeout:
      "30s"
    outputs:
    savedId:
      savedId
    retryPolicy:
    maximumAttempts:
      3
    initialInterval:
      "500ms"
      - id: publishSuccess
    op:
      publishSuccess
    inputs:
    id:
      "${savedId}"
    data:
      "${processedData}"
    transitions:
      - condition: 'error != nil && error.contains("database")'
    to:
      databaseError
      - condition: 'error != nil'
    to:
      saveError
      - condition: 'true'
    to:
      success

    databaseError:
    sequence:
      - id: saveToBackupStorage
    op:
      saveToBackupStorage
    inputs:
    data:
      "${processedData}"
    outputs:
    backupId:
      backupId
      - id: scheduleDataReconciliation
    op:
      scheduleDataReconciliation
    inputs:
    backupId:
      "${backupId}"
    primaryStorage:
      "database"
    transitions:
      - condition: 'backupId != null'
    to:
      partialSuccess
      - condition: 'true'
    to:
      criticalFailure

    saveError:
    op:
      logSaveError
    inputs:
    error:
      "${error}"
    severity:
      "error"
    transitions:
      - condition: 'true'
    to:
      criticalFailure

  # Terminal states for different error scenarios
    authFailure:
    op:
      notifyAuthFailure
    inputs:
    message:
      "Authentication failed after refresh attempt"
    severity:
      "critical"

    rateLimitExceeded:
    op:
      notifyRateLimitExceeded
    inputs:
    message:
      "Rate limit exceeded after ${maxRetries} retries"
    severity:
      "error"

    validationFailure:
    op:
      notifyValidationFailure
    inputs:
    message:
      "Data validation failed and could not be repaired"
    data:
      "${data}"

    processingError:
    op:
      notifyProcessingError
    inputs:
    message:
      "Data processing failed"
    lastError:
      "${error}"

    criticalFailure:
    sequence:
      - id: notifyCriticalFailure
    op:
      notifyCriticalFailure
    inputs:
    message:
      "Critical failure in workflow"
    lastErrorType:
      "${lastErrorType}"
    error:
      "${error}"
      - id: triggerAlert
    op:
      triggerAlert
    inputs:
    alertLevel:
      "critical"
    workflow:
      "error-handling-example"

    partialSuccess:
    op:
      notifyPartialSuccess
    inputs:
    message:
      "Data saved to backup storage, reconciliation scheduled"
    backupId:
      "${backupId}"

    success:
    op:
      notifySuccess
    inputs:
    message:
      "Workflow completed successfully"
    savedId:
      "${savedId}"

# Configuration parameters that would be provided at runtime
    config:
    dataSourceUrl:
      "https://api.example.com/data"
    refreshToken:
      "refresh_token_here"
    alertWebhook:
      "https://alerts.example.com/webhook"
