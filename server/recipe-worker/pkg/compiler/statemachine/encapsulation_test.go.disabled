package statemachine

import (
	"testing"

	yamlpkg "github.com/divisive-ai/vibethis/server/recipe-core/pkg/yaml"
	"github.com/stretchr/testify/assert"
	"github.com/stretchr/testify/require"
	"go.temporal.io/sdk/testsuite"
	"go.temporal.io/sdk/workflow"
)

// mockActivityExecutor for testing nested scopes
type mockActivityExecutor struct {
	results map[string]map[string]interface{}
}

func (m *mockActivityExecutor) ExecuteActivity(ctx workflow.Context, activityName string, inputs map[string]interface{}) (map[string]interface{}, error) {
	if result, exists := m.results[activityName]; exists {
		return result, nil
	}
	// Default return for activities
	return map[string]interface{}{
		"output": activityName + "_result",
		"data":   inputs,
	}, nil
}

func TestNestedScopeEncapsulation(t *testing.T) {
	testSuite := &testsuite.WorkflowTestSuite{}
	env := testSuite.NewTestWorkflowEnvironment()

	// Create mock executor
	executor := &mockActivityExecutor{
		results: map[string]map[string]interface{}{
			"activity1": {"result": "value1"},
			"activity2": {"result": "value2"},
			"activity3": {"result": "value3"},
		},
	}

	// Test workflow
	env.ExecuteWorkflow(func(ctx workflow.Context) error {
		compiler, err := NewStateMachineCompiler(executor)
		require.NoError(t, err)

		// Create a state context
		stateCtx := &yamlpkg.StateContext{
			CurrentState: "test",
			Inputs: map[string]interface{}{
				"global_input": "global_value",
			},
			StateOutputs: make(map[string]map[string]interface{}),
			StepOutputs:  make(map[string]interface{}),
		}

		// Create root scope
		rootScope := NewScopedContext(nil, stateCtx, "root")

		// Test nested sequential with isolated scopes
		sequentialSteps := []yamlpkg.Node{
			{
				ID:   "step1",
				Op: "activity1",
				Inputs: map[string]interface{}{
					"input": "{{ .Inputs.global_input }}",
				},
			},
			{
				ID: "nested_seq",
				Sequential: []yamlpkg.Node{
					{
						ID:   "nested_step1",
						Op: "activity2",
						Inputs: map[string]interface{}{
							// This should NOT see step1 output
							"input": "{{ .Steps.step1.result }}",
						},
					},
					{
						ID:   "nested_step2",
						Op: "activity3",
						Inputs: map[string]interface{}{
							// This SHOULD see nested_step1 output
							"input": "{{ .Steps.nested_step1.result }}",
						},
					},
				},
			},
		}

		// Execute sequential with scoping
		outputs, err := compiler.executeSequentialScoped(ctx, sequentialSteps, rootScope)
		require.NoError(t, err)

		// Verify outputs
		assert.NotNil(t, outputs)
		
		// step1 should be in root scope outputs
		assert.Contains(t, outputs, "step1")
		
		// nested_seq should contain its nested outputs
		assert.Contains(t, outputs, "nested_seq")
		nestedOutputs, ok := outputs["nested_seq"].(map[string]interface{})
		assert.True(t, ok)
		assert.Contains(t, nestedOutputs, "nested_step1")
		assert.Contains(t, nestedOutputs, "nested_step2")

		return nil
	})

	require.NoError(t, env.GetWorkflowError())
}

func TestParallelScopeIsolation(t *testing.T) {
	testSuite := &testsuite.WorkflowTestSuite{}
	env := testSuite.NewTestWorkflowEnvironment()

	executor := &mockActivityExecutor{
		results: map[string]map[string]interface{}{
			"parallel_activity1": {"count": 1},
			"parallel_activity2": {"count": 2},
		},
	}

	env.ExecuteWorkflow(func(ctx workflow.Context) error {
		compiler, err := NewStateMachineCompiler(executor)
		require.NoError(t, err)

		stateCtx := &yamlpkg.StateContext{
			CurrentState: "test",
			Inputs:       make(map[string]interface{}),
			StateOutputs: make(map[string]map[string]interface{}),
			StepOutputs:  make(map[string]interface{}),
		}

		rootScope := NewScopedContext(nil, stateCtx, "root")

		// Test parallel execution with nested compositions
		parallelSteps := []yamlpkg.Node{
			{
				ID: "branch1",
				Sequential: []yamlpkg.Node{
					{
						ID:   "branch1_step1",
						Op: "parallel_activity1",
					},
					{
						ID:   "branch1_step2",
						Op: "parallel_activity2",
						Inputs: map[string]interface{}{
							// Should see branch1_step1 in same branch
							"prev": "{{ .Steps.branch1_step1.count }}",
						},
					},
				},
			},
			{
				ID: "branch2",
				Sequential: []yamlpkg.Node{
					{
						ID:   "branch2_step1",
						Op: "parallel_activity1",
					},
					{
						ID:   "branch2_step2",
						Op: "parallel_activity2",
						Inputs: map[string]interface{}{
							// Should NOT see branch1_step1 from other branch
							"own": "{{ .Steps.branch2_step1.count }}",
						},
					},
				},
			},
		}

		outputs, err := compiler.executeParallelScoped(ctx, parallelSteps, rootScope)
		require.NoError(t, err)

		// Verify each branch has isolated outputs
		assert.Contains(t, outputs, "branch1")
		assert.Contains(t, outputs, "branch2")

		branch1Outputs, ok := outputs["branch1"].(map[string]interface{})
		assert.True(t, ok)
		assert.Contains(t, branch1Outputs, "branch1_step1")
		assert.Contains(t, branch1Outputs, "branch1_step2")

		branch2Outputs, ok := outputs["branch2"].(map[string]interface{})
		assert.True(t, ok)
		assert.Contains(t, branch2Outputs, "branch2_step1")
		assert.Contains(t, branch2Outputs, "branch2_step2")

		return nil
	})

	require.NoError(t, env.GetWorkflowError())
}

func TestConditionalScopeEncapsulation(t *testing.T) {
	testSuite := &testsuite.WorkflowTestSuite{}
	env := testSuite.NewTestWorkflowEnvironment()

	executor := &mockActivityExecutor{
		results: map[string]map[string]interface{}{
			"cond_activity": {"status": "success"},
		},
	}

	env.ExecuteWorkflow(func(ctx workflow.Context) error {
		compiler, err := NewStateMachineCompiler(executor)
		require.NoError(t, err)

		stateCtx := &yamlpkg.StateContext{
			CurrentState: "test",
			Inputs: map[string]interface{}{
				"condition_flag": true,
			},
			StateOutputs: make(map[string]map[string]interface{}),
			StepOutputs:  make(map[string]interface{}),
		}

		rootScope := NewScopedContext(nil, stateCtx, "root")

		// Add a step output to root scope for testing
		rootScope.SetStepOutput("root_step", map[string]interface{}{"value": "root_value"})

		// Test conditional with nested scope
		conditionalBranches := []ConditionalBranch{
			{
				When: ".Inputs.condition_flag == true",
				Sequential: []yamlpkg.Node{
					{
						ID:   "cond_step1",
						Op: "cond_activity",
					},
					{
						ID:   "cond_step2",
						Op: "cond_activity",
						Inputs: map[string]interface{}{
							// Should see cond_step1 in same branch
							"prev": "{{ .Steps.cond_step1.status }}",
							// Should NOT see root_step from parent scope
							"root": "{{ .Steps.root_step.value }}",
						},
					},
				},
			},
			{
				Default: true,
				Op:    "cond_activity",
			},
		}

		result, err := compiler.executeConditionalScoped(ctx, conditionalBranches, rootScope)
		require.NoError(t, err)
		assert.NotNil(t, result)

		// The conditional result should be the merged outputs from the executed branch
		branchOutputs, ok := result.(map[string]interface{})
		assert.True(t, ok)
		assert.Contains(t, branchOutputs, "cond_step1")
		assert.Contains(t, branchOutputs, "cond_step2")

		return nil
	})

	require.NoError(t, env.GetWorkflowError())
}

func TestDeeplyNestedScopes(t *testing.T) {
	testSuite := &testsuite.WorkflowTestSuite{}
	env := testSuite.NewTestWorkflowEnvironment()

	executor := &mockActivityExecutor{}

	env.ExecuteWorkflow(func(ctx workflow.Context) error {
		compiler, err := NewStateMachineCompiler(executor)
		require.NoError(t, err)

		stateCtx := &yamlpkg.StateContext{
			CurrentState: "test",
			Inputs: map[string]interface{}{
				"level": 0,
			},
			StateOutputs: make(map[string]map[string]interface{}),
			StepOutputs:  make(map[string]interface{}),
		}

		rootScope := NewScopedContext(nil, stateCtx, "root")

		// Test deeply nested structure
		steps := []yamlpkg.Node{
			{
				ID: "level1",
				Sequential: []yamlpkg.Node{
					{
						ID:   "level1_step",
						Op: "activity",
					},
					{
						ID: "level2",
						Parallel: []yamlpkg.Node{
							{
								ID: "level2_branch1",
								Sequential: []yamlpkg.Node{
									{
										ID:   "level3_step",
										Op: "activity",
									},
									{
										ID: "level4",
										Conditional: []ConditionalBranch{
											{
												Default: true,
												Sequential: []yamlpkg.Node{
													{
														ID:   "level5_step",
														Op: "activity",
														Inputs: map[string]interface{}{
															// Should only see level3_step from parent sequential
															"sibling": "{{ .Steps.level3_step.output }}",
															// Should NOT see level1_step from grandparent
															"grandparent": "{{ .Steps.level1_step.output }}",
														},
													},
												},
											},
										},
									},
								},
							},
						},
					},
				},
			},
		}

		outputs, err := compiler.executeSequentialScoped(ctx, steps, rootScope)
		require.NoError(t, err)
		assert.NotNil(t, outputs)

		// Verify the nested structure
		assert.Contains(t, outputs, "level1")
		level1, ok := outputs["level1"].(map[string]interface{})
		assert.True(t, ok)
		
		assert.Contains(t, level1, "level2")
		level2, ok := level1["level2"].(map[string]interface{})
		assert.True(t, ok)
		
		assert.Contains(t, level2, "level2_branch1")

		return nil
	})

	require.NoError(t, env.GetWorkflowError())
}

func TestScopeTemplateResolution(t *testing.T) {
	// Test template resolution with scoped context
	stateCtx := &yamlpkg.StateContext{
		Inputs: map[string]interface{}{
			"global": "global_value",
		},
		StateOutputs: map[string]map[string]interface{}{
			"prev_state": {
				"data": "state_output",
			},
		},
	}

	rootScope := NewScopedContext(nil, stateCtx, "root")
	rootScope.SetStepOutput("step1", map[string]interface{}{"value": "step1_value"})
	rootScope.SetStepOutput("step2", map[string]interface{}{"value": "step2_value"})

	// Create nested scope
	nestedScope := NewScopedContext(rootScope, stateCtx, "nested")
	nestedScope.SetStepOutput("nested_step", map[string]interface{}{"value": "nested_value"})

	// Test template resolution in nested scope
	resolver := NewScopedTemplateResolver()

	// Should see only nested scope steps
	inputs := map[string]interface{}{
		"nested": "{{ .Steps.nested_step.value }}",
		"parent": "{{ .Steps.step1.value }}", // Should not resolve
		"global": "{{ .Inputs.global }}",     // Should see global inputs
		"state":  "{{ .States.prev_state.data }}", // Should see state outputs
	}

	resolved, err := resolver.ResolveInputsScoped(inputs, nestedScope)
	require.NoError(t, err)

	assert.Equal(t, "nested_value", resolved["nested"])
	assert.Equal(t, "global_value", resolved["global"])
	assert.Equal(t, "state_output", resolved["state"])
	// Parent step should not resolve (template remains as is or empty)
	assert.NotEqual(t, "step1_value", resolved["parent"])
}

func TestScopeCELEvaluation(t *testing.T) {
	compiler, err := NewStateMachineCompiler(nil)
	require.NoError(t, err)

	stateCtx := &yamlpkg.StateContext{
		CurrentState: "test",
		Inputs: map[string]interface{}{
			"threshold": 10,
		},
		StateOutputs: map[string]map[string]interface{}{
			"previous": {
				"count": 5,
			},
		},
	}

	// Create scoped context
	scope := NewScopedContext(nil, stateCtx, "test")
	scope.SetStepOutput("local_step", map[string]interface{}{"value": 15})

	// Test CEL evaluation with scoped context
	// Should see local steps
	result, err := compiler.evaluateCELScoped(".Steps.local_step.value > 10", nil, scope)
	assert.NoError(t, err)
	assert.True(t, result)

	// Should see global inputs
	result, err = compiler.evaluateCELScoped(".Inputs.threshold == 10", nil, scope)
	assert.NoError(t, err)
	assert.True(t, result)

	// Should see state outputs
	result, err = compiler.evaluateCELScoped(".States.previous.count < 10", nil, scope)
	assert.NoError(t, err)
	assert.True(t, result)

	// Create nested scope
	nestedScope := NewScopedContext(scope, stateCtx, "nested")
	nestedScope.SetStepOutput("nested_step", map[string]interface{}{"value": 20})

	// Nested scope should only see its own steps
	result, err = compiler.evaluateCELScoped(".Steps.nested_step.value == 20", nil, nestedScope)
	assert.NoError(t, err)
	assert.True(t, result)

	// Should NOT see parent scope steps
	result, err = compiler.evaluateCELScoped(".Steps.local_step.value > 0", nil, nestedScope)
	assert.Error(t, err) // Should fail because local_step is not in nested scope
}