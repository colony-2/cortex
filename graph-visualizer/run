#!/bin/bash

# Run script for Graph Visualizer

set -e

# Default values
PATH_TO_SCAN=${1:-./example}
MODE=${2:-dev}

echo "Starting Graph Visualizer..."
echo "Usage: ./run [path-to-scan] [mode]"
echo "  path-to-scan: Directory to scan (default: ./example)"
echo "  mode: 'dev' or 'prod' (default: dev)"
echo ""
echo "Scanning path: $PATH_TO_SCAN"
echo "Mode: $MODE"
echo ""

if [ "$MODE" = "prod" ]; then
    # Production mode - build and run
    if [ ! -f "build/graph-visualizer" ]; then
        echo "Production binary not found. Building..."
        make build
    fi
    ./build/graph-visualizer -path="$PATH_TO_SCAN"
else
    # Development mode
    cd server
    go run main.go -path="$PATH_TO_SCAN"
fi
