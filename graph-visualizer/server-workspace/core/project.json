{
  "name": "core",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "server-workspace/core",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "server-workspace/core",
        "command": "go build ./..."
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "server-workspace/core",
        "command": "go test -v ./..."
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "server-workspace/core",
        "command": "go vet ./..."
      }
    }
  },
  "tags": ["go", "backend", "library"]
}