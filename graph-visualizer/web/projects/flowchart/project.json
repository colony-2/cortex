{
  "name": "@vibethis/flowchart",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "web/projects/flowchart",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "@nx/vite:build",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/web/projects/flowchart",
        "configFile": "web/projects/flowchart/vite.config.ts"
      }
    },
    "test": {
      "executor": "@nx/vite:test",
      "outputs": ["{workspaceRoot}/coverage/web/projects/flowchart"],
      "options": {
        "passWithNoTests": true,
        "reportsDirectory": "{workspaceRoot}/coverage/web/projects/flowchart"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  },
  "tags": ["frontend", "library"]
}