{
  "name": "graph-visualizer-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "projects/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@graph-visualizer/app",
    "build": "npm run build:shared && npm run build:projects && npm run build --workspace=@graph-visualizer/app",
    "build:shared": "npm run build --workspace=@graph-visualizer/shared",
    "build:projects": "npm run build --workspace=@graph-visualizer/files && npm run build --workspace=@graph-visualizer/config && npm run build --workspace=@graph-visualizer/changes && npm run build --workspace=@graph-visualizer/flowchart",
    "preview": "npm run preview --workspace=@graph-visualizer/app",
    "test": "npm run test --workspace=@graph-visualizer/app",
    "build:all": "npm run build --workspaces",
    "test:all": "npm run test --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "clean": "rm -rf projects/*/dist && rm -rf projects/*/node_modules/.vite"
  },
  "dependencies": {
    "@ant-design/icons": "^6.0.0",
    "@ant-design/pro-flow": "^1.3.12",
    "@monaco-editor/react": "^4.7.0",
    "@rjsf/core": "^5.24.12",
    "@rjsf/utils": "^5.24.12",
    "@rjsf/validator-ajv8": "^5.24.12",
    "@types/dagre": "^0.7.52",
    "@xyflow/react": "^12.7.0",
    "antd": "^5.26.1",
    "dagre": "^0.8.5",
    "monaco-editor": "^0.52.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@playwright/test": "^1.53.1",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5"
  }
}
