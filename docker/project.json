{
  "name": "shai-docker",
  "root": "docker",
  "projectType": "application",
  "tags": ["docker", "infrastructure"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker build -t debian-dev:dev --target dev .",
        "cwd": "docker"
      }
    },
    "integration": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "bash tests/integration/test_image.sh",
        "cwd": "docker"
      }
    }
  }
}
