{
  "name": "rwshim-clib",
  "root": "rwshim/clib",
  "projectType": "application",
  "tags": ["infrastructure", "docker"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker build -t rwshim:latest .",
        "cwd": "rwshim/clib"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./run_tests_docker.sh",
        "cwd": "rwshim/clib"
      }
    }
  }
}
