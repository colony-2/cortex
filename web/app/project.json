{
  "name": "ui-app",
  "root": "web/app",
  "sourceRoot": "web/app/src",
  "projectType": "application",
  "tags": ["frontend", "react"],
  "targets": {
    "build": {
      "executor": "@nx/vite:build",
      "dependsOn": ["ui-flowchart:build", "ui-kanban:build", "web-shared:build"],
      "options": {
        "configFile": "web/app/vite.config.ts",
        "outputPath": "web/app/dist"
      }
    },
    "serve": {
      "executor": "@nx/vite:dev",
      "options": {
        "configFile": "web/app/vite.config.ts"
      }
    },
    "test": {
      "executor": "@nx/vite:test",
      "options": {
        "configFile": "web/app/vite.config.ts"
      }
    },
    "e2e": {
      "executor": "nx:run-commands",
      "dependsOn": ["be-api:build-test-server"],
      "options": {
        "command": "npx playwright test --reporter=list",
        "cwd": "web/app"
      }
    }
  }
}
