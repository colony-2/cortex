{
  "name": "fe-openapi",
  "root": "web/openapi",
  "projectType": "library",
  "tags": ["frontend"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["api-openapi:build"],
      "options": {
        "command": "npm run generate && npm run build",
        "cwd": "web/openapi",
        "outputs": ["{projectRoot}/src/generated", "{projectRoot}/dist"]
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "true",
        "cwd": "web/openapi"
      }
    }
  }
}
