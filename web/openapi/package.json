{
  "name": "@vibethis/openapi-client",
  "version": "1.0.0",
  "description": "Generated TypeScript client from VibeThis OpenAPI specification",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "generate": "openapi-typescript-codegen --input ../../api/openapi/vibethis-api.yaml --output ./src/generated --client axios",
    "clean": "rm -rf src/generated dist"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "openapi-typescript-codegen": "^0.25.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "axios": "^1.6.0"
  },
  "files": [
    "dist",
    "src"
  ]
}