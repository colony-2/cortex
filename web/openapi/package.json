{
  "name": "@vibethis/openapi-client",
  "version": "1.0.0",
  "description": "Generated TypeScript client from VibeThis OpenAPI specification",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --clean && tsc --emitDeclarationOnly",
    "generate": "openapi --input ../../api/openapi/vibethis-api.yaml --output ./src/generated --client fetch",
    "clean": "rm -rf src/generated dist"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "openapi-typescript-codegen": "^0.25.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {},
  "files": [
    "dist",
    "src"
  ]
}
