{
  "name": "@colony2/cortex",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:api": "bash scripts/go.sh run ./server/cmd/api",
    "dev:test-api": "bash scripts/go.sh run ./server/cmd/uitestserver",
    "dev:web": "pnpm --filter @colony2/app dev",
    "test:api": "bash scripts/go.sh test ./server/...",
    "test": "bash scripts/run-all-tests.sh",
    "test:web": "pnpm --filter @colony2/shared test && pnpm --filter @colony2/app test",
    "test:e2e": "pnpm --filter @colony2/app test:e2e",
    "typecheck:web": "pnpm --filter @colony2/shared typecheck && pnpm --filter @colony2/app typecheck",
    "build:web": "pnpm --filter @colony2/shared build && pnpm --filter @colony2/app build"
  },
  "packageManager": "pnpm@10.0.0"
}
